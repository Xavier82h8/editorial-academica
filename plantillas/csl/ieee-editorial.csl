<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="in-text" version="1.0" demote-non-dropping-particle="sort-only">
  <info>
    <title>IEEE Reference Guide version 11.29.2023 (editorial-academica, Ref Guide 2025)</title>
    <title-short>Institute of Electrical and Electronics Engineers</title-short>
    <id>http://www.zotero.org/styles/ieee-editorial-academica</id>
    <link href="http://www.zotero.org/styles/ieee-editorial-academica" rel="self"/>
    <link href="https://journals.ieeeauthorcenter.ieee.org/your-role-in-article-production/ieee-editorial-style-manual/" rel="documentation"/>
    <author>
      <name>Michael Berkowitz</name>
      <email>mberkowi@gmu.edu</email>
    </author>
    <contributor>
      <name>Julian Onions</name>
      <email>julian.onions@gmail.com</email>
    </contributor>
    <contributor>
      <name>Rintze Zelle</name>
      <uri>http://twitter.com/rintzezelle</uri>
    </contributor>
    <contributor>
      <name>Stephen Frank</name>
      <uri>http://www.zotero.org/sfrank</uri>
    </contributor>
    <contributor>
      <name>Sebastian Karcher</name>
    </contributor>
    <contributor>
      <name>Giuseppe Silano</name>
      <email>g.silano89@gmail.com</email>
      <uri>http://giuseppesilano.net</uri>
    </contributor>
    <contributor>
      <name>Patrick O'Brien</name>
    </contributor>
    <contributor>
      <name>Brenton M. Wiernik</name>
    </contributor>
    <contributor>
      <name>Oliver Couch</name>
      <email>oliver.couch@gmail.com</email>
    </contributor>
    <contributor>
      <name>Andrew Dunning</name>
      <uri>https://orcid.org/0000-0003-0464-5036</uri>
    </contributor>
    <category citation-format="numeric"/>
    <category field="engineering"/>
    <category field="generic-base"/>
    <summary>IEEE style as per the 2023 guidelines.</summary>
    <updated>2024-03-27T11:41:27+00:00</updated>
    <rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License</rights>
  </info>
  <locale xml:lang="en">
    <date form="text">
      <date-part name="month" form="short" suffix=" "/>
      <!-- editorial-academica: dia sin cero a la izquierda (Mon. D, YYYY) [Ref Guide 2025 §Dates] -->
      <date-part name="day" form="numeric" suffix=", "/>
      <date-part name="year"/>
    </date>
    <terms>
      <term name="chapter" form="short">ch.</term>
      <term name="chapter-number" form="short">ch.</term>
      <term name="presented at">presented at the</term>
      <term name="available at">available</term>
      <!-- always use three-letter abbreviations for months -->
      <term name="month-06" form="short">Jun.</term>
      <term name="month-07" form="short">Jul.</term>
      <term name="month-09" form="short">Sep.</term>
    </terms>
  </locale>
  <!-- editorial-academica: español -- fecha "D mes. AAAA" (nunca "mes. D, AAAA"), "presentado en"; decisión 18-nov-2026: abreviaturas IEEE en inglés (no., pp., Art. no.) y coma DENTRO de las comillas como en la Reference Guide -->
  <locale xml:lang="es">
    <style-options punctuation-in-quote="true"/>
    <date form="text">
      <date-part name="day" form="numeric" suffix=" "/>
      <date-part name="month" form="short" suffix=" "/>
      <date-part name="year"/>
    </date>
    <terms>
      <term name="presented at">presentado en</term>
      <term name="issue" form="short">
        <single>no.</single>
        <multiple>nos.</multiple>
      </term>
    </terms>
  </locale>
  <!-- Macros -->
  <!-- editorial-academica: status en minusculas y sin negrita ("early access", "to be published", "submitted for publication", "unpublished", "private communication") [Ref Guide 2025 §Periodicals / Unpublished] -->
  <macro name="status">
    <choose>
      <if variable="page issue volume" match="none">
        <text variable="status"/>
      </if>
    </choose>
  </macro>
  <macro name="edition">
    <choose>
      <if type="bill book chapter graphic legal_case legislation motion_picture paper-conference report song" match="any">
        <choose>
          <if is-numeric="edition">
            <group delimiter=" ">
              <number variable="edition" form="ordinal"/>
              <text term="edition" form="short"/>
            </group>
          </if>
          <else>
            <text variable="edition" text-case="capitalize-first" suffix="."/>
          </else>
        </choose>
      </if>
    </choose>
  </macro>
  <!-- editorial-academica: fecha con dia opcional (Mon. D, YYYY) y rangos de dias (Oct. 5-8, 2010) para todo salvo libros/tesis (solo anio) [Ref Guide 2025 §Dates] -->
  <macro name="issued">
    <choose>
      <if type="bill book chapter graphic legal_case legislation song thesis" match="any">
        <date variable="issued">
          <date-part name="year" form="long"/>
        </date>
      </if>
      <else-if type="motion_picture" match="any">
        <date variable="issued" form="text" prefix="(" suffix=")"/>
      </else-if>
      <else>
        <!-- editorial-academica: forma `text` de cada locale (en: "Oct. 5-8, 2010"; es: "5-8 oct. 2010") -->
        <date variable="issued" form="text"/>
      </else>
    </choose>
  </macro>
  <macro name="author">
    <names variable="author">
      <name and="text" et-al-min="7" et-al-use-first="1" initialize-with=". "/>
      <label form="short" prefix=", " text-case="capitalize-first"/>
      <et-al font-style="italic"/>
      <substitute>
        <names variable="editor"/>
        <names variable="translator"/>
        <text macro="director"/>
      </substitute>
    </names>
  </macro>
  <macro name="editor">
    <names variable="editor">
      <name initialize-with=". " delimiter=", " and="text"/>
      <label form="short" prefix=", " text-case="capitalize-first"/>
    </names>
  </macro>
  <!-- editorial-academica: traductor ", trans. Nombre Apellido" (nombre completo como en la guia) [Ref Guide 2025 §Books] -->
  <macro name="translator">
    <names variable="translator">
      <label form="short" suffix=" "/>
      <name and="text" delimiter=", "/>
    </names>
  </macro>
  <macro name="director">
    <names variable="director">
      <name and="text" et-al-min="7" et-al-use-first="1" initialize-with=". "/>
      <et-al font-style="italic"/>
    </names>
  </macro>
  <!-- editorial-academica: volumen/numero como texto (no como numero) para conservar "ED-11" sin convertir el guion en raya [Ref Guide 2025 §Periodicals] -->
  <macro name="locators">
    <group delimiter=", ">
      <text macro="edition"/>
      <group delimiter=" ">
        <text term="volume" form="short"/>
        <text variable="volume"/>
      </group>
      <group delimiter=" ">
        <number variable="number-of-volumes" form="numeric"/>
        <text term="volume" form="short" plural="true"/>
      </group>
      <group delimiter=" ">
        <text term="issue" form="short"/>
        <text variable="issue"/>
      </group>
    </group>
  </macro>
  <macro name="title">
    <choose>
      <if type="bill book graphic legal_case legislation motion_picture song standard software" match="any">
        <text variable="title" font-style="italic"/>
      </if>
      <else>
        <text variable="title" quotes="true"/>
      </else>
    </choose>
  </macro>
  <macro name="publisher">
    <choose>
      <if type="bill book chapter graphic legal_case legislation motion_picture paper-conference song" match="any">
        <group delimiter=": ">
          <text variable="publisher-place"/>
          <text variable="publisher"/>
        </group>
      </if>
      <else>
        <group delimiter=", ">
          <text variable="publisher"/>
          <text variable="publisher-place"/>
        </group>
      </else>
    </choose>
  </macro>
  <!-- editorial-academica: lugar del congreso (event-place o publisher-place) [Ref Guide 2025 §Conferences] -->
  <macro name="place">
    <choose>
      <if variable="event-place">
        <text variable="event-place"/>
      </if>
      <else>
        <text variable="publisher-place"/>
      </else>
    </choose>
  </macro>
  <!-- editorial-academica: "in Proc. ..." (publicado) o "presented at the <evento>" (no publicado); la variable CSL-JSON actual es event-title, no event [Ref Guide 2025 §Conferences] -->
  <macro name="event">
    <choose>
      <if variable="container-title">
        <group delimiter=" ">
          <text term="in"/>
          <text variable="container-title" font-style="italic"/>
        </group>
      </if>
      <else>
        <group delimiter=" ">
          <text term="presented at"/>
          <text variable="event-title"/>
        </group>
      </else>
    </choose>
  </macro>
  <!-- editorial-academica: orden "Accessed: fecha. [Online]. Available: URL" ; "[Online]." se emite siempre que hay URL (antes se perdia sin fecha de acceso) [Ref Guide 2025 §Online] -->
  <macro name="access">
    <choose>
      <if variable="DOI">
        <!-- doi: 10.1000/xyz123. -->
        <text variable="DOI" prefix=" doi: " suffix="."/>
      </if>
      <else-if variable="URL">
        <group delimiter=" " prefix=" ">
          <group delimiter=": " suffix=".">
            <text term="accessed" text-case="capitalize-first"/>
            <date variable="accessed" form="text"/>
          </group>
          <group prefix="[" suffix="]." delimiter=" ">
            <choose>
              <if variable="medium" match="any">
                <text variable="medium" text-case="capitalize-first"/>
              </if>
              <else>
                <text term="online" text-case="capitalize-first"/>
                <choose>
                  <if type="motion_picture">
                    <text term="video" text-case="capitalize-first"/>
                  </if>
                </choose>
              </else>
            </choose>
          </group>
          <group delimiter=": ">
            <text term="available at" text-case="capitalize-first"/>
            <text variable="URL"/>
          </group>
        </group>
      </else-if>
    </choose>
  </macro>
  <!-- editorial-academica: cierre del bloque principal: "," antes de doi, "." en los demas casos [Ref Guide 2025 §Online/DOI] -->
  <macro name="end">
    <choose>
      <if variable="DOI">
        <text value=","/>
      </if>
      <else>
        <text value="."/>
      </else>
    </choose>
  </macro>
  <macro name="page">
    <group delimiter=" ">
      <label variable="page" form="short"/>
      <text variable="page"/>
    </group>
  </macro>
  <!-- editorial-academica: "Art. no. X" va despues de la fecha en articulos de revista [Ref Guide 2025 §Periodicals with article ID] -->
  <macro name="article-number">
    <choose>
      <if type="article-journal" variable="number" match="all">
        <group delimiter=" ">
          <text value="Art. no."/>
          <text variable="number"/>
        </group>
      </if>
    </choose>
  </macro>
  <macro name="citation-locator">
    <group delimiter=" ">
      <choose>
        <if locator="page">
          <label variable="locator" form="short"/>
        </if>
        <else>
          <label variable="locator" form="short" text-case="capitalize-first"/>
        </else>
      </choose>
      <text variable="locator"/>
    </group>
  </macro>
  <macro name="geographic-location">
    <group delimiter=", " suffix=".">
      <choose>
        <if variable="publisher-place">
          <text variable="publisher-place" text-case="title"/>
        </if>
        <else-if variable="event-place">
          <text variable="event-place" text-case="title"/>
        </else-if>
      </choose>
    </group>
  </macro>
  <!-- editorial-academica: serie entre parentesis tras el titulo: "(Series Title, no. N)" [Ref Guide 2025 §Books with series] -->
  <macro name="collection">
    <group delimiter=", " prefix=" (" suffix=")">
      <text variable="collection-title"/>
      <text variable="collection-number" prefix="no. "/>
    </group>
  </macro>
  <!-- Citation -->
  <!-- editorial-academica: citas [1], [2], [3] sin colapsar a rangos (regla 2025); no hay atributo collapse -->
  <citation>
    <sort>
      <key variable="citation-number"/>
    </sort>
    <layout delimiter=", ">
      <group prefix="[" suffix="]" delimiter=", ">
        <text variable="citation-number"/>
        <text macro="citation-locator"/>
      </group>
    </layout>
  </citation>
  <!-- Bibliography -->
  <bibliography entry-spacing="0" second-field-align="flush">
    <layout>
      <!-- Citation Number -->
      <text variable="citation-number" prefix="[" suffix="]"/>
      <!-- Author(s) -->
      <text macro="author" suffix=", "/>
      <!-- Rest of Citation -->
      <choose>
        <!-- Specific Formats -->
        <!-- editorial-academica: fecha tras vol./no./pp. y estado ("early access") antes de la fecha; Art. no. al final [Ref Guide 2025 §Periodicals] -->
        <if type="article-journal">
          <group delimiter=", ">
            <text macro="title"/>
            <text variable="container-title" font-style="italic" form="short"/>
            <text macro="locators"/>
            <text macro="page"/>
            <text macro="status"/>
            <text macro="issued"/>
            <text macro="article-number"/>
          </group>
          <text macro="end"/>
          <text macro="access"/>
        </if>
        <!-- editorial-academica: manuscrito inedito: "'Titulo,' submitted for publication." / "unpublished." [Ref Guide 2025 §Unpublished] -->
        <else-if type="manuscript">
          <group delimiter=", ">
            <text macro="title"/>
            <text variable="status"/>
            <text macro="issued"/>
          </group>
          <text macro="end"/>
          <text macro="access"/>
        </else-if>
        <!-- editorial-academica: comunicacion privada: "A. Autor, private communication, May 1995." [Ref Guide 2025 §Unpublished] -->
        <else-if type="personal_communication">
          <group delimiter=", ">
            <text value="private communication"/>
            <text macro="issued"/>
          </group>
          <text value="."/>
        </else-if>
        <!-- editorial-academica: congreso con editorial: "in Proc., vol. N. Lugar: Editorial, anio, pp." ; sin editorial: "in Proc., Lugar, fecha, vol., no., pp., Paper N" ; "presented at the" para ponencias no publicadas [Ref Guide 2025 §Conferences] -->
        <else-if type="paper-conference speech" match="any">
          <choose>
            <if variable="publisher">
              <group delimiter=", " suffix=". ">
                <text macro="title"/>
                <text macro="event"/>
                <text macro="locators"/>
                <text macro="editor"/>
              </group>
              <group delimiter=", ">
                <text macro="publisher"/>
                <text macro="issued"/>
                <text macro="page"/>
                <text macro="status"/>
              </group>
            </if>
            <else>
              <group delimiter=", ">
                <text macro="title"/>
                <text macro="event"/>
                <text macro="editor"/>
                <text macro="place"/>
                <text macro="issued"/>
                <text macro="locators"/>
                <text macro="page"/>
                <text macro="status"/>
                <text variable="number" prefix="Paper "/>
              </group>
            </else>
          </choose>
          <text macro="end"/>
          <text macro="access"/>
        </else-if>
        <!-- editorial-academica: capitulo: "in Libro (Serie, no. N), Editores, Eds., Lugar: Ed., anio" ; sin editores "in Libro. Lugar: Ed." [Ref Guide 2025 §Books, chapters] -->
        <else-if type="chapter">
          <group delimiter=", ">
            <text macro="title"/>
            <group delimiter=" ">
              <text term="in"/>
              <group>
                <text variable="container-title" font-style="italic"/>
                <text macro="collection"/>
              </group>
            </group>
            <text macro="locators"/>
            <text macro="editor"/>
          </group>
          <choose>
            <if variable="editor">
              <text value=", "/>
            </if>
            <else>
              <text value=". "/>
            </else>
          </choose>
          <group delimiter=", ">
            <text macro="publisher"/>
            <text macro="issued"/>
            <group delimiter=" ">
              <label variable="chapter-number" form="short"/>
              <text variable="chapter-number"/>
            </group>
            <text macro="page"/>
          </group>
          <text macro="end"/>
          <text macro="access"/>
        </else-if>
        <else-if type="report">
          <group delimiter=", ">
            <text macro="title"/>
            <text macro="publisher"/>
            <group delimiter=" ">
              <text variable="genre"/>
              <text variable="number"/>
            </group>
            <text macro="issued"/>
          </group>
          <text macro="end"/>
          <text macro="access"/>
        </else-if>
        <else-if type="thesis">
          <group delimiter=", ">
            <text macro="title"/>
            <text variable="genre"/>
            <text macro="publisher"/>
            <text macro="issued"/>
          </group>
          <text macro="end"/>
          <text macro="access"/>
        </else-if>
        <else-if type="software">
          <group delimiter=". " suffix=".">
            <text macro="title"/>
            <text macro="issued" prefix="(" suffix=")"/>
            <text variable="genre"/>
            <text macro="publisher"/>
          </group>
          <text macro="access"/>
        </else-if>
        <!-- editorial-academica: preprint arXiv: "*arXiv:NNNN.NNNNN*" (publisher=arXiv, number=identificador) todo en cursiva y sin espacio [Ref Guide 2025 §arXiv] -->
        <else-if type="article">
          <group delimiter=", ">
            <text macro="title"/>
            <text macro="issued"/>
            <group delimiter=":" font-style="italic">
              <text variable="publisher"/>
              <text variable="number"/>
            </group>
          </group>
          <text macro="end"/>
          <text macro="access"/>
        </else-if>
        <!-- editorial-academica: blog/pagina web: titulo, sitio en cursiva, fecha completa (Mon. D, YYYY) [Ref Guide 2025 §Blogs] -->
        <else-if type="webpage post-weblog post" match="any">
          <group delimiter=", ">
            <text macro="title"/>
            <text variable="container-title" font-style="italic"/>
            <text macro="issued"/>
          </group>
          <text macro="end"/>
          <text macro="access"/>
        </else-if>
        <!-- editorial-academica: patente "U.S. Patent 3 624 125, fecha." [Ref Guide 2025 §Patents] -->
        <else-if type="patent">
          <group delimiter=", ">
            <text macro="title"/>
            <group delimiter=" ">
              <text variable="authority"/>
              <text value="Patent"/>
              <text variable="number"/>
            </group>
            <text macro="issued"/>
          </group>
          <text macro="end"/>
          <text macro="access"/>
        </else-if>
        <!-- Online Video -->
        <else-if type="motion_picture">
          <text macro="geographic-location" suffix=". "/>
          <group delimiter=", " suffix=".">
            <text macro="title"/>
            <text macro="issued"/>
          </group>
          <text macro="access"/>
        </else-if>
        <else-if type="standard">
          <group delimiter=", ">
            <text macro="title"/>
            <group delimiter=" ">
              <text variable="genre"/>
              <text variable="number"/>
            </group>
            <text macro="geographic-location"/>
            <text macro="issued"/>
          </group>
          <text macro="end"/>
          <text macro="access"/>
        </else-if>
        <!-- editorial-academica: libro: "Titulo (Serie, no. N), trans. Nombre Apellido. Lugar: Editorial, anio, pp." [Ref Guide 2025 §Books] -->
        <else-if type="bill book graphic legal_case legislation song" match="any">
          <group delimiter=", " suffix=". ">
            <group>
              <text macro="title"/>
              <text macro="collection"/>
            </group>
            <text macro="translator"/>
            <text macro="locators"/>
          </group>
          <group delimiter=", ">
            <text macro="publisher"/>
            <text macro="issued"/>
            <text macro="page"/>
          </group>
          <text macro="end"/>
          <text macro="access"/>
        </else-if>
        <else-if type="article-magazine article-newspaper broadcast interview map" match="any">
          <group delimiter=", ">
            <text macro="title"/>
            <text variable="container-title" font-style="italic"/>
            <text macro="locators"/>
            <text macro="publisher"/>
            <text macro="page"/>
            <text macro="issued"/>
          </group>
          <text macro="end"/>
          <text macro="access"/>
        </else-if>
        <else>
          <group delimiter=", " suffix=". ">
            <text macro="title"/>
            <text variable="container-title" font-style="italic"/>
            <text macro="locators"/>
          </group>
          <group delimiter=", ">
            <text macro="publisher"/>
            <text macro="page"/>
            <text macro="issued"/>
          </group>
          <text macro="end"/>
          <text macro="access"/>
        </else>
      </choose>
    </layout>
  </bibliography>
</style>
